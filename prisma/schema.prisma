// FTS AI Workspace — Phase 0 schema.
// Auth tables follow the Better Auth core schema (users, sessions, accounts, verifications).
// Organization, membership and audit tables are owned by src/features and src/server (ADR-008).
// Review every migration before applying it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth adapter-owned)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Member[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Organization {
  id                    String                @id @default(uuid(7)) @db.Uuid
  name                  String
  slug                  String                @unique
  /// Who may see rankings. OFF (default): nobody; OPT_IN: only members who chose to appear.
  leaderboardVisibility LeaderboardVisibility @default(OFF)
  /// Tokens the organization's AI features may use per UTC day (a ceiling, not a purchase).
  aiDailyTokenBudget    Int                   @default(200000)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  members              Member[]
  auditLogs            AuditLog[]
  projects             Project[]
  goals                Goal[]
  tasks                Task[]
  taskComments         TaskComment[]
  milestones           Milestone[]
  aiTaskPlans          AiTaskPlan[]
  invitations          Invitation[]
  channels             Channel[]
  channelMembers       ChannelMember[]
  messages             Message[]
  notifications        Notification[]
  pointEvents          PointEvent[]
  challenges           Challenge[]
  fileObjects          FileObject[]
  fileShares           FileShare[]
  knowledgeDocuments   KnowledgeDocument[]
  documentChunks       DocumentChunk[]
  jobs                 Job[]
  aiUsageEvents        AiUsageEvent[]
  crmContacts          CrmContact[]
  crmDeals             CrmDeal[]
  crmActivities        CrmActivity[]
  consentEvents        ConsentEvent[]
  appointments         Appointment[]
  appointmentAttendees AppointmentAttendee[]

  @@map("organizations")
}

model Member {
  id                String           @id @default(uuid(7)) @db.Uuid
  organizationId    String           @db.Uuid
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String           @db.Uuid
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              MemberRole
  status            MembershipStatus @default(ACTIVE)
  /// Appears on the leaderboard (only matters when the organization enables it). Off by default.
  showOnLeaderboard Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("members")
}

/// Single-use, expiring invitation. Only a SHA-256 hash of the token is stored; the token itself
/// exists only in the invitation email. A partial unique index (see migration) allows one pending
/// invitation per (organization, email).
model Invitation {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole
  tokenHash      String       @unique
  invitedById    String       @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?      @db.Uuid
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Productivity
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProgressMode {
  TASK_BASED
  MILESTONE_BASED
  NUMERIC_KPI
  MANUAL
}

model Project {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  goals Goal[]
  tasks Task[]

  /// Target of composite foreign keys so children must share the organization.
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("projects")
}

model Goal {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?      @db.Uuid
  project        Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentGoalId   String?      @db.Uuid
  parentGoal     Goal?        @relation("GoalTree", fields: [parentGoalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children       Goal[]       @relation("GoalTree")
  tasks          Task[]
  milestones     Milestone[]
  aiTaskPlans    AiTaskPlan[]
  title          String
  description    String?
  status         GoalStatus   @default(ACTIVE)
  progressMode   ProgressMode @default(MANUAL)
  /// Manual progress, 0-100. Only meaningful for `MANUAL` mode.
  manualProgress Int?
  targetValue    Decimal?     @db.Decimal(18, 4)
  currentValue   Decimal?     @db.Decimal(18, 4)
  ownerId        String       @db.Uuid
  dueAt          DateTime?
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, parentGoalId])
  @@index([organizationId, projectId])
  @@index([organizationId, ownerId, status])
  @@map("goals")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?      @db.Uuid
  project        Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goalId         String?      @db.Uuid
  goal           Goal?        @relation(fields: [goalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentTaskId   String?      @db.Uuid
  parentTask     Task?        @relation("SubTasks", fields: [parentTaskId, organizationId], references: [id, organizationId], onDelete: Restrict)
  subTasks       Task[]       @relation("SubTasks")
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?      @db.Uuid
  createdById    String       @db.Uuid
  startsAt       DateTime?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments TaskComment[]

  @@unique([id, organizationId])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, goalId])
  @@index([organizationId, parentTaskId])
  @@map("tasks")
}

model TaskComment {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String       @db.Uuid
  task           Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId       String       @db.Uuid
  body           String
  createdAt      DateTime     @default(now())

  @@index([organizationId, taskId, createdAt])
  @@map("task_comments")
}

model Milestone {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goalId         String       @db.Uuid
  goal           Goal         @relation(fields: [goalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  title          String
  dueAt          DateTime?
  completedAt    DateTime?
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, goalId])
  @@map("milestones")
}

enum AiPlanStatus {
  DRAFT
  APPLIED
  DISCARDED
}

/// A model-generated task plan. It is only a proposal: nothing becomes a task until
/// the requester reviews and applies it. `draft` holds validated suggestions only.
model AiTaskPlan {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goalId         String       @db.Uuid
  goal           Goal         @relation(fields: [goalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  requestedById  String       @db.Uuid
  objective      String
  draft          Json
  status         AiPlanStatus @default(DRAFT)
  provider       String
  model          String
  appliedAt      DateTime?
  appliedCount   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, goalId])
  @@index([organizationId, requestedById, createdAt])
  @@map("ai_task_plans")
}

// ---------------------------------------------------------------------------
// Collaboration
// ---------------------------------------------------------------------------

enum ChannelType {
  CHANNEL
  DM
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  DIRECT_MESSAGE
  APPOINTMENT_INVITED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELLED
}

/// A chat room. Every channel, public or private, has explicit `ChannelMember` rows; membership
/// (not the organization alone) decides who can read or post. A DM is a two-member channel whose
/// `dmKey` ("<smaller user id>:<larger user id>") makes it unique per pair.
model Channel {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ChannelType  @default(CHANNEL)
  name           String?
  isPrivate      Boolean      @default(false)
  dmKey          String?
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())

  members  ChannelMember[]
  messages Message[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@unique([organizationId, dmKey])
  @@map("channels")
}

model ChannelMember {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId      String       @db.Uuid
  channel        Channel      @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId         String       @db.Uuid
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([channelId, userId])
  @@index([organizationId, userId])
  @@map("channel_members")
}

/// Chat message. Deleting is soft: the body is blanked and `deletedAt` set so history stays consistent.
model Message {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId      String       @db.Uuid
  channel        Channel      @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId       String       @db.Uuid
  body           String
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, channelId, createdAt, id])
  @@index([organizationId, authorId, createdAt])
  @@map("messages")
}

/// In-app notification. It references what happened but carries no content, so the text is
/// rendered from the current (authorized) data and the user's locale.
model Notification {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String           @db.Uuid
  type           NotificationType
  actorId        String?          @db.Uuid
  resourceType   String
  resourceId     String           @db.Uuid
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId, userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

enum LeaderboardVisibility {
  OFF
  OPT_IN
}

enum PointEventType {
  TASK_COMPLETED
}

enum ChallengeStatus {
  ACTIVE
  ARCHIVED
}

/// Append-only points ledger (a database trigger rejects UPDATE and DELETE). One award per
/// (user, type, source), so retries and reopen/complete cycles can never award twice. Points
/// are a recognition metric only, never a balance, payment or entitlement.
model PointEvent {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String         @db.Uuid
  type           PointEventType
  points         Int
  sourceType     String
  sourceId       String         @db.Uuid
  createdAt      DateTime       @default(now())

  @@unique([organizationId, userId, type, sourceId])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, createdAt])
  @@map("point_events")
}

/// A time-boxed target on points events. Progress is computed from the ledger, not stored.
model Challenge {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  /// Number of completed tasks (ledger awards) that finishes the challenge.
  target         Int
  startsAt       DateTime
  endsAt         DateTime
  status         ChallengeStatus @default(ACTIVE)
  createdById    String          @db.Uuid
  createdAt      DateTime        @default(now())

  @@index([organizationId, status, endsAt])
  @@map("challenges")
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

enum FileVisibility {
  /// Only the uploader.
  PRIVATE
  /// Uploader plus the members listed in `FileShare`.
  SHARED
  /// Every active member of the organization.
  ORGANIZATION
}

enum FileStatus {
  READY
  DELETED
}

/// Metadata for an uploaded file. The bytes live in the storage adapter under `storageKey`
/// (server-generated, never derived from the file name). `name` is display-only.
model FileObject {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedById   String         @db.Uuid
  name           String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String         @unique
  visibility     FileVisibility @default(PRIVATE)
  status         FileStatus     @default(READY)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())

  shares    FileShare[]
  documents KnowledgeDocument[]

  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, uploadedById])
  @@map("files")
}

model FileShare {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileId         String       @db.Uuid
  file           FileObject   @relation(fields: [fileId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId         String       @db.Uuid
  createdAt      DateTime     @default(now())

  @@unique([fileId, userId])
  @@index([organizationId, userId])
  @@map("file_shares")
}

// ---------------------------------------------------------------------------
// Knowledge and background jobs
// ---------------------------------------------------------------------------

enum DocumentStatus {
  PENDING
  INDEXED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// A file that has been added to the knowledge base. It has **no access rules of its own**: who
/// may find it is decided by the file's rule at query time, so changing a file's sharing or
/// deleting it takes effect on the next search with nothing to synchronize.
model KnowledgeDocument {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileId         String         @db.Uuid
  file           FileObject     @relation(fields: [fileId, organizationId], references: [id, organizationId], onDelete: Cascade)
  status         DocumentStatus @default(PENDING)
  chunkCount     Int            @default(0)
  error          String?
  indexedAt      DateTime?
  createdById    String         @db.Uuid
  createdAt      DateTime       @default(now())

  chunks DocumentChunk[]

  @@unique([id, organizationId])
  @@unique([fileId])
  @@index([organizationId, status])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id             String                   @id @default(uuid(7)) @db.Uuid
  organizationId String                   @db.Uuid
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String                   @db.Uuid
  document       KnowledgeDocument        @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  ordinal        Int
  content        String
  /// Generated column (see migration): to_tsvector('simple', content), GIN-indexed.
  tsv            Unsupported("tsvector")?

  @@unique([documentId, ordinal])
  @@index([organizationId, documentId])
  @@map("document_chunks")
}

/// Database-backed job queue (claimed with FOR UPDATE SKIP LOCKED). `dedupeKey` makes enqueueing
/// idempotent per organization.
model Job {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  payload        Json
  status         JobStatus    @default(QUEUED)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  runAt          DateTime     @default(now())
  lockedAt       DateTime?
  lastError      String?
  dedupeKey      String?
  createdAt      DateTime     @default(now())
  finishedAt     DateTime?

  @@unique([organizationId, dedupeKey])
  @@index([status, runAt])
  @@map("jobs")
}

enum AiFeature {
  TASK_PLAN
  KNOWLEDGE_ANSWER
}

enum AiUsageStatus {
  OK
  ERROR
}

/// One row per model call: who, which feature, which model, how many tokens and how long.
/// It never stores prompts or answers. `tokens` is the provider's count when it reports one,
/// otherwise an estimate (characters / 4), so budgets work with any provider.
model AiUsageEvent {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @db.Uuid
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId          String        @db.Uuid
  feature         AiFeature
  provider        String
  model           String
  status          AiUsageStatus
  tokens          Int
  tokensEstimated Boolean       @default(false)
  latencyMs       Int
  createdAt       DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, createdAt])
  @@map("ai_usage_events")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

enum ConsentStatus {
  UNKNOWN
  GRANTED
  WITHDRAWN
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
}

/// Personal data about someone outside the organization. Owned by one member; access rules live in
/// the CRM service. Erasure anonymizes the personal fields and keeps the row so deals and reports
/// stay consistent.
model CrmContact {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @db.Uuid
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name             String
  /// Stored lowercase.
  email            String?
  phone            String?
  company          String?
  ownerId          String        @db.Uuid
  consentStatus    ConsentStatus @default(UNKNOWN)
  consentUpdatedAt DateTime?
  erasedAt         DateTime?
  createdById      String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  deals        CrmDeal[]
  activities   CrmActivity[]
  consents     ConsentEvent[]
  appointments Appointment[]

  @@unique([id, organizationId])
  @@index([organizationId, ownerId])
  @@map("crm_contacts")
}

/// Append-only proof of when and how consent changed.
model ConsentEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contactId      String        @db.Uuid
  contact        CrmContact    @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Restrict)
  status         ConsentStatus
  /// How consent was obtained or withdrawn, for example "signed form" or "email reply".
  source         String
  recordedById   String        @db.Uuid
  createdAt      DateTime      @default(now())

  @@index([organizationId, contactId, createdAt])
  @@map("consent_events")
}

model CrmDeal {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contactId       String       @db.Uuid
  contact         CrmContact   @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Restrict)
  title           String
  stage           DealStage    @default(LEAD)
  /// Minor units (cents). No payment is ever taken from this value.
  amountMinor     Int?
  currency        String       @default("USD")
  ownerId         String       @db.Uuid
  expectedCloseAt DateTime?
  closedAt        DateTime?
  createdById     String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  activities CrmActivity[]

  @@unique([id, organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, ownerId])
  @@index([organizationId, contactId])
  @@map("crm_deals")
}

model CrmActivity {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contactId      String       @db.Uuid
  contact        CrmContact   @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Restrict)
  dealId         String?      @db.Uuid
  deal           CrmDeal?     @relation(fields: [dealId, organizationId], references: [id, organizationId], onDelete: Restrict)
  type           ActivityType
  body           String
  authorId       String       @db.Uuid
  occurredAt     DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId, contactId, occurredAt])
  @@map("crm_activities")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
}

enum AttendeeResponse {
  PENDING
  ACCEPTED
  DECLINED
}

/// A meeting between members, optionally about a CRM contact. Times are stored in UTC.
/// Visible only to the organizer and the attendees.
model Appointment {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  location       String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  organizerId    String            @db.Uuid
  contactId      String?           @db.Uuid
  contact        CrmContact?       @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  attendees AppointmentAttendee[]

  @@unique([id, organizationId])
  @@index([organizationId, startsAt])
  @@map("appointments")
}

model AppointmentAttendee {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointmentId  String           @db.Uuid
  appointment    Appointment      @relation(fields: [appointmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId         String           @db.Uuid
  response       AttendeeResponse @default(PENDING)
  createdAt      DateTime         @default(now())

  @@unique([appointmentId, userId])
  @@index([organizationId, userId])
  @@map("appointment_attendees")
}

// ---------------------------------------------------------------------------
// Governance
// ---------------------------------------------------------------------------

/// Append-only audit trail. Never store secrets or raw content in `metadata`.
model AuditLog {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId        String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  correlationId  String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
