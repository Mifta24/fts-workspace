// FTS AI Workspace — Phase 0 schema.
// Auth tables follow the Better Auth core schema (users, sessions, accounts, verifications).
// Organization, membership and audit tables are owned by src/features and src/server (ADR-008).
// Review every migration before applying it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth adapter-owned)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Member[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      Member[]
  auditLogs    AuditLog[]
  projects     Project[]
  goals        Goal[]
  tasks        Task[]
  taskComments TaskComment[]
  milestones   Milestone[]
  aiTaskPlans  AiTaskPlan[]
  invitations  Invitation[]

  @@map("organizations")
}

model Member {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("members")
}

/// Single-use, expiring invitation. Only a SHA-256 hash of the token is stored; the token itself
/// exists only in the invitation email. A partial unique index (see migration) allows one pending
/// invitation per (organization, email).
model Invitation {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole
  tokenHash      String       @unique
  invitedById    String       @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?      @db.Uuid
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Productivity
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProgressMode {
  TASK_BASED
  MILESTONE_BASED
  NUMERIC_KPI
  MANUAL
}

model Project {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  goals Goal[]
  tasks Task[]

  /// Target of composite foreign keys so children must share the organization.
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("projects")
}

model Goal {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?      @db.Uuid
  project        Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentGoalId   String?      @db.Uuid
  parentGoal     Goal?        @relation("GoalTree", fields: [parentGoalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children       Goal[]       @relation("GoalTree")
  tasks          Task[]
  milestones     Milestone[]
  aiTaskPlans    AiTaskPlan[]
  title          String
  description    String?
  status         GoalStatus   @default(ACTIVE)
  progressMode   ProgressMode @default(MANUAL)
  /// Manual progress, 0-100. Only meaningful for `MANUAL` mode.
  manualProgress Int?
  targetValue    Decimal?     @db.Decimal(18, 4)
  currentValue   Decimal?     @db.Decimal(18, 4)
  ownerId        String       @db.Uuid
  dueAt          DateTime?
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, parentGoalId])
  @@index([organizationId, projectId])
  @@index([organizationId, ownerId, status])
  @@map("goals")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?      @db.Uuid
  project        Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  goalId         String?      @db.Uuid
  goal           Goal?        @relation(fields: [goalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentTaskId   String?      @db.Uuid
  parentTask     Task?        @relation("SubTasks", fields: [parentTaskId, organizationId], references: [id, organizationId], onDelete: Restrict)
  subTasks       Task[]       @relation("SubTasks")
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?      @db.Uuid
  createdById    String       @db.Uuid
  startsAt       DateTime?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments TaskComment[]

  @@unique([id, organizationId])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, goalId])
  @@index([organizationId, parentTaskId])
  @@map("tasks")
}

model TaskComment {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String       @db.Uuid
  task           Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId       String       @db.Uuid
  body           String
  createdAt      DateTime     @default(now())

  @@index([organizationId, taskId, createdAt])
  @@map("task_comments")
}

model Milestone {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goalId         String       @db.Uuid
  goal           Goal         @relation(fields: [goalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  title          String
  dueAt          DateTime?
  completedAt    DateTime?
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, goalId])
  @@map("milestones")
}

enum AiPlanStatus {
  DRAFT
  APPLIED
  DISCARDED
}

/// A model-generated task plan. It is only a proposal: nothing becomes a task until
/// the requester reviews and applies it. `draft` holds validated suggestions only.
model AiTaskPlan {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goalId         String       @db.Uuid
  goal           Goal         @relation(fields: [goalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  requestedById  String       @db.Uuid
  objective      String
  draft          Json
  status         AiPlanStatus @default(DRAFT)
  provider       String
  model          String
  appliedAt      DateTime?
  appliedCount   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, goalId])
  @@index([organizationId, requestedById, createdAt])
  @@map("ai_task_plans")
}

// ---------------------------------------------------------------------------
// Governance
// ---------------------------------------------------------------------------

/// Append-only audit trail. Never store secrets or raw content in `metadata`.
model AuditLog {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId        String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  correlationId  String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
