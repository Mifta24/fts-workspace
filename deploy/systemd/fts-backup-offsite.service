# /etc/systemd/system/fts-backup-offsite.service: copy the newest backups outside this server.
[Unit]
Description=Copy the newest FTS Workspace backups off the server
After=fts-backup.service
OnFailure=fts-alert-unit@%N.service

[Service]
Type=oneshot
User=fts
ExecStart=/opt/fts-workspace/bin/backup-offsite.sh
