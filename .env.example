# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection (docker compose or `pnpm db:local`).
DATABASE_URL="postgresql://fts:fts_dev_password@127.0.0.1:5432/fts_workspace"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Email delivery: "log" writes auth emails to the server log (development only).
EMAIL_TRANSPORT="log"
EMAIL_FROM="FTS Workspace <no-reply@localhost>"

# Optional AI task planning (OpenAI-compatible chat completions; disabled when unset).
# AI_BASE_URL="https://openrouter.ai/api/v1"   # or http://127.0.0.1:1234/v1 for LM Studio
# AI_API_KEY=""
# AI_MODEL=""

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# Optional: password for development seed users (pnpm db:seed).
# SEED_PASSWORD=""
