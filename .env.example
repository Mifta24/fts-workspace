# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection (docker compose or `pnpm db:local`).
DATABASE_URL="postgresql://fts:fts_dev_password@127.0.0.1:5432/fts_workspace"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Email delivery: "log" writes auth emails to the server log (development only).
EMAIL_TRANSPORT="log"
EMAIL_FROM="FTS Workspace <no-reply@localhost>"

# Optional AI task planning (OpenAI-compatible chat completions; disabled when unset).
# AI_BASE_URL="https://openrouter.ai/api/v1"   # or http://127.0.0.1:1234/v1 for LM Studio
# AI_API_KEY=""
# AI_MODEL=""

# Uploaded files (local-disk adapter; keep outside any web root and back it up).
# STORAGE_DIR=".data/files"

# Optional Cloudflare Turnstile captcha for public forms and booking pages (set both or neither).
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# Optional: password for development seed users (pnpm db:seed).
# SEED_PASSWORD=""

# Optional realtime gateway (Socket.IO). Without these the app works but updates need a refresh.
# Run the gateway with `pnpm gateway` (needs DATABASE_URL, APP_URL, REALTIME_PUBLISH_SECRET).
# REALTIME_URL="http://127.0.0.1:4000"            # server-to-gateway (publishing)
# REALTIME_PUBLIC_URL="http://localhost:4000"     # browser-to-gateway; same host name as the app
# REALTIME_PUBLISH_SECRET=""                      # >= 32 chars, shared by app and gateway
# APP_URL="http://localhost:3000"                 # gateway only: where sessions are verified
